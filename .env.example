# Hugging Face Inference API token
# Get one for free at https://huggingface.co/settings/tokens
HF_API_TOKEN=..............................

# Embedding model served via HF Inference API
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_PROVIDER=hf-inference

# LLM model served via HF Inference API (chat-completion compatible)
HF_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
HF_LLM_PROVIDER=novita

# Path to the source dataset
DATA_PATH=data/lf_jobs.csv

# Chroma persistence directory
CHROMA_PERSIST_DIR=data/chroma_store
CHROMA_COLLECTION_NAME=lf_jobs

# Retrieval config
TOP_N_DEFAULT=5
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4

# Chunking config
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=50